# Local dev environment. Copy to .env.local and fill in the values.
# .env.local is gitignored; never commit a real token.

# Monday.com API token for the contact form endpoint (app/api/contact).
# Get this from https://monday.com → Admin → Developers → Tokens.
# Needs write access to the Leads board (id 3979078971).
MONDAY_API_TOKEN=

# Optional: override the production site URL used in sitemap.xml,
# robots.txt, and OpenGraph tags. Default is https://www.fastforward.sh.
# NEXT_PUBLIC_SITE_URL=https://www.fastforward.sh

# Pantheon Content Publisher — pulls Lab Project pages authored in
# Google Docs (and later Word) into the site. Scoped to the
# lab-projects collection (id NuPhuiula8qj9g0oR9rS). Only used by
# the lib/pcc.ts data source and the /api/revalidate webhook.
#
# In Pantheon Secrets Manager, set these three with:
#   Secret Type: Environment  (NOT Runtime — Runtime secrets aren't
#                              surfaced as process.env.X for Next.js)
#   Secret Scopes: Job + Web   (Job for `next build` time, Web for
#                              the running Node server)
# Matches how the existing MONDAY_API_TOKEN is configured.
PCC_SITE_ID=
PCC_TOKEN=

# Shared secret used in the webhook URL query string (?token=...) so
# /api/revalidate can authenticate incoming requests from PCC. The same
# value must be present here AND in the URL configured in PCC's webhook.
# Generate fresh with `openssl rand -hex 32`.
PCC_WEBHOOK_SECRET=

# GitHub repo path (owner/name) used by the draft-status toast to link
# at the PR for the current draft. Exposed to the client because the
# toast is rendered in a "use client" component.
NEXT_PUBLIC_GITHUB_REPO=fast-forward-innovation/fastforward-com
